{
    "info": {
        "name": "Glowify API Automation",
        "_postman_id": "b1f6a8c0-1234-4567-890a-glowify",
        "description": "Automation collection for Glowify APIs",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Login API",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\\n  \\\"username\\\": \\\"your_username\\\",\\n  \\\"password\\\": \\\"your_password\\\"\\n}"
                },
                "url": {
                    "raw": "https://glowify-cosmetics-site.onrender.com/accounts/login/",
                    "protocol": "https",
                    "host": [
                        "glowify-cosmetics-site",
                        "onrender",
                        "com"
                    ],
                    "path": [
                        "accounts",
                        "login",
                        ""
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test(\"Status code is 200\", function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "let jsonData = pm.response.json();",
                            "pm.environment.set(\"auth_token\", jsonData.token);"
                        ]
                    }
                }
            ]
        },
        {
